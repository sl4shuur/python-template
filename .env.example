# Settings use the KS_ prefix and __ for nested fields.
# Relative paths are resolved from the project root.
KS_APP_NAME=kaggle_starter

# Logging
KS_LOGGING__DIRECTORY=logs
KS_LOGGING__LEVEL=INFO
KS_LOGGING__FORMATTER=ColoredFormatter
KS_LOGGING__DATE_FORMAT="%d-%m-%Y %H:%M:%S"
KS_LOGGING__FULL_COLOR=true
KS_LOGGING__INCLUDE_FUNCTION=true
KS_LOGGING__SUCCESS_LEVEL=69

# Data and run artifacts
KS_DATA__COMPETITION_DIR=data/competition
KS_DATA__OUTPUT_DIR=outputs

# Validation split
KS_SPLIT__VALIDATION_FRACTION=0.2
KS_SPLIT__SEED=42
# Optional: uncomment and set a column name to split by group.
# KS_SPLIT__GROUP_COLUMN=patient_id
KS_SPLIT__STRATIFY=false

# Experiment tracking
KS_TRACKING__PROJECT=kaggle-experiments
# KS_TRACKING__ENTITY=your-team
KS_TRACKING__OFFLINE=false
KS_TRACKING__API_KEY="your-api-key"

# Data loaders
KS_LOADER__BATCH_SIZE=128
KS_LOADER__VAL_BATCH_SIZE=32
KS_LOADER__PREDICT_BATCH_SIZE=32
KS_LOADER__NUM_WORKERS=0
KS_LOADER__PIN_MEMORY=false
KS_LOADER__SEED=0

# Learning rate scheduler
KS_LR_SCHEDULER__NAME=none
# Cosine scheduler
KS_LR_SCHEDULER__T_MAX=10
KS_LR_SCHEDULER__MIN_LR=0.0
# Plateau scheduler
KS_LR_SCHEDULER__FACTOR=0.1
KS_LR_SCHEDULER__PATIENCE=2
# Monitor: loss or other metric
KS_LR_SCHEDULER__MONITOR=val/loss
KS_LR_SCHEDULER__MODE=min

# Training (metric mode: min for losses/errors, max for accuracy or ranking scores)
KS_TRAIN__MAX_EPOCHS=10
KS_TRAIN__SEED=42
KS_TRAIN__CHECKPOINT_METRIC=val/loss
KS_TRAIN__CHECKPOINT_MODE=min
KS_TRAIN__CHECKPOINT_TOP_K=1
KS_TRAIN__EARLY_STOPPING_PATIENCE=3
KS_TRAIN__ACCUMULATE_GRAD_BATCHES=1
KS_TRAIN__GRADIENT_CLIP_VAL=1.0
KS_TRAIN__LOG_EVERY_N_STEPS=10

# Runtime
KS_RUNTIME__ACCELERATOR=auto
KS_RUNTIME__DEVICES=auto
KS_RUNTIME__PRECISION=auto
